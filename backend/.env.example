# Copy to backend/.env. Every value has a working default for local development.

ENVIRONMENT=development            # development | production
# SQLite by default; PostgreSQL works unchanged:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/studyraid
DATABASE_URL=sqlite+aiosqlite:///./studyraid.db

# Signs access tokens. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false                # must be true in production
ALLOW_REGISTRATION=true

# The WebSocket's Origin must be one of these (JSON list).
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# In-process scheduler: reminders, quest expiry, streak freezes, challenge settlement.
# Set false and run `python -m app.workers.scheduler` separately when scaling the API.
WORKER_ENABLED=true
WORKER_INTERVAL_SECONDS=60

# Shows the demo account on the sign-in page. Refused in production.
DEMO_MODE=true
